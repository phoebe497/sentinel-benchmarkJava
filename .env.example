LLM_PROVIDER=opencode

# Analysis agent + Streamlit chat: OpenCode zen (OpenAI-compatible).
# NineRouterProvider.from_env() reads only these variables.
OPENCODE_BASE_URL=https://opencode.ai/zen/go/v1
OPENCODE_API_KEY=your-api-key
CUSTOM_SCAN_MODEL=deepseek-v4-pro
OPENCODE_TIMEOUT_SECONDS=60
OPENCODE_MAX_RETRIES=1

SENTINEL_UI_READONLY=1
