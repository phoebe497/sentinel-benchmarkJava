LLM_PROVIDER=opencode

# Analysis agent + Streamlit chat: OpenCode zen (OpenAI-compatible).
# NineRouterProvider.from_env() reads only these variables.
OPENCODE_BASE_URL=https://opencode.ai/zen/go/v1
OPENCODE_API_KEY=your-api-key
OPENCODE_TIMEOUT_SECONDS=60
OPENCODE_MAX_RETRIES=1

# One agent, one model. The same model serves the analysis pass (step 3) and the
# post-probe verification pass (step 8), so any change in accuracy is
# attributable to the pass and not to a model swap. Confirm the exact id against
# GET /models first: uv run python scripts/analyze.py preflight --provider nine_router
# Ask Sentinel chat (OpenCode zen). Independent of CUSTOM_SCAN_MODEL used for
# the batch analysis agent.
CHAT_MODEL=glm-5.2

SENTINEL_UI_READONLY=1
# Set to 1 only on a private host that may send playground probes through the lab gateway.
# SENTINEL_GATEWAY_SANDBOX=0

# --- Week 6 lab stack (docker-compose.yml) -------------------------------- #
# Generated once by `bash scripts/stack.sh up`; never commit the real values.
# The gateway reads GATEWAY_API_KEY, the request tool reads
# SENTINEL_GATEWAY_API_KEY: same secret, two names, two processes.
GATEWAY_API_KEY=generated-by-scripts-stack-sh
SENTINEL_GATEWAY_API_KEY=generated-by-scripts-stack-sh
SENTINEL_GATEWAY_URL=http://localhost:8080
